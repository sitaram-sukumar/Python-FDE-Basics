    "def showAll(*args, **kwargs):\n",
    "    print(args)\n",
    "    print(kwargs)\n",
    "    print(args[2])\n",
    "    for a in args:\n",
    "        print(a)\n",
    "        \n",
    "    ka = { k:v for k,v in kwargs.items() if len(k)!=4 }\n",
    "    print(ka)\n",
    "    \n",
